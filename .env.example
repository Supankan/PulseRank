# PulseRank Environment Configuration
ENV=development
APP_NAME=PulseRank
DEBUG=True
API_PORT=8000
API_HOST=0.0.0.0

# Database
# Default uses PostgreSQL. SQLite fallback is supported if POSTGRES_URL is not set: sqlite:///./data/pulserank.db
DATABASE_URL=postgresql+psycopg2://pulserank:pulserank@localhost:5432/pulserank_db

# Storage Paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
ARTIFACTS_DIR=artifacts

# ML Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
POPULARITY_DECAY_HOURS=72.0
ALS_FACTORS=64
ALS_REGULARIZATION=0.05
ALS_ITERATIONS=15
RANKER_MAX_DEPTH=6
RANKER_NUM_LEAVES=31
RANKER_LEARNING_RATE=0.05
RANKER_N_ESTIMATORS=150

# Candidate Retrieval Limits
CONTENT_TOP_K=50
COLLAB_TOP_K=50
POPULARITY_TOP_K=50
FINAL_FEED_LIMIT=20
